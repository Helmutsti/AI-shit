{
  "description": "Guardrail meccanici del metodo. Hook in Node (exec form): 'node' e' un binario vero su ogni OS, quindi funziona identico su Windows e Mac.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/annota-comando-rapido.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/proteggi-docs.js"],
            "statusMessage": "Verifico chi sta scrivendo nei docs/",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/scrivi-nel-progetto.js"],
            "statusMessage": "Verifico che la scrittura resti dentro il progetto",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/commit-descrittivo.js"],
            "statusMessage": "Controllo che il messaggio di commit spieghi il perche'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/snapshot-dati.js"],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/verifica-dati.js"],
            "statusMessage": "Verifico che i dati di test siano stati ripuliti",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/gate-e2e.js"],
            "statusMessage": "Verifica end-to-end (build/test)",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
